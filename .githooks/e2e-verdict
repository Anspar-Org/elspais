#!/bin/bash
# =====================================================
# e2e-verdict: the one authority for the cached e2e verdict
# =====================================================
#
# Runs the e2e tier and records the verdict in .results/.test-cache-e2e,
# keyed on the committed tree (git write-tree) and the source directory the
# on-PATH elspais resolves to. The pre-push hook honors a verdict this
# script recorded, so running it before `git push` moves the several-minute
# e2e stage out of the push, where a long run otherwise overruns the
# remote's idle timeout.
#
# A verdict already recorded for the same tree and environment is honored
# without re-running: exit 0 on PASS, exit 1 on FAIL. Re-run a recorded
# verdict with ELSPAIS_E2E_FORCE=1. The verdict is written only by a real
# run -- never pre-write PASS.

set -e
set -o pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
CACHE_DIR="$REPO_ROOT/.results"
E2E_CACHE="$CACHE_DIR/.test-cache-e2e"
CONTENT_HASH=$(git write-tree | head -c 40)
mkdir -p "$CACHE_DIR"

# Killing this script must not kill the tier it started — see the library.
. "$REPO_ROOT/.githooks/lib-tier-run.sh"

# The tier re-enters a fresh interpreter -- `sys.executable`, a spawned
# daemon -- and such a child inherits no sys.path from pytest, so the
# environment that decides the verdict is the interpreter pytest runs
# under, NOT the `elspais` launcher. Those two are separate installs and
# routinely disagree. Identify the environment by where THAT interpreter
# finds elspais, and make it the cache key.
# A console-script shebang is not reliably `#!<absolute-path-to-python>`: some
# layouts write `#!/usr/bin/env python3`, and options may follow the
# interpreter. So walk the shebang's words, step over the `env` trampoline and
# any flags, and resolve a bare name through PATH as `env` itself would. This
# is the reading the commit hook already uses, and it matters more here,
# because an interpreter this cannot identify is refused rather than warned
# about. An interpreter that cannot be identified yields no answer rather than
# a wrong one.
e2e_env_src() {
    _bin=$(command -v pytest 2>/dev/null) || return 1
    _shebang=$(head -1 "$_bin" 2>/dev/null) || return 1
    case "$_shebang" in
        '#!'*) ;;
        *) return 1 ;;
    esac

    _py=""
    # A path may hold a space, and the word walk below would cut it in half.
    # The whole remainder is the interpreter wherever it names one, so try
    # that first and walk only for the `env` and option forms.
    _rest=$(printf '%s' "${_shebang#\#!}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -x "$_rest" ]; then
        "$_rest" -c 'import elspais,os;print(os.path.realpath(os.path.dirname(elspais.__file__)))' 2>/dev/null
        return
    fi

    for _word in ${_shebang#\#!}; do
        case "$_word" in
            -*) continue ;;
        esac
        case "$(basename "$_word")" in
            env) continue ;;
        esac
        case "$_word" in
            /*) _py="$_word" ;;
            *)  _py=$(command -v "$_word" 2>/dev/null) || _py="" ;;
        esac
        if [ -n "$_py" ]; then break; fi
    done

    [ -n "$_py" ] || return 1
    [ -x "$_py" ] || return 1
    "$_py" -c 'import elspais,os;print(os.path.realpath(os.path.dirname(elspais.__file__)))' 2>/dev/null
}
E2E_REPO_SRC=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "src/elspais") \
    || E2E_REPO_SRC="$REPO_ROOT/src/elspais"

# The worktree's venv is the environment this tree's tier means -- its
# pytest, its interpreter, its elspais. No worktree's own tier means some
# other installation, so prefer it always rather than only on a mismatch:
# the probe below is what says whether it worked.
if [ -d "$REPO_ROOT/.venv/bin" ]; then
    PATH="$REPO_ROOT/.venv/bin:$PATH"
    export PATH
fi
E2E_ENV_SRC=$(e2e_env_src) || E2E_ENV_SRC=""

# A run under the wrong interpreter says nothing about this tree, so it must
# not reach the cache: a recorded FAIL is keyed on the tree and blocks every
# later push of it, which turns an environment fault into a durable verdict
# about the code. Refuse before running instead.
if [ "$E2E_ENV_SRC" != "$E2E_REPO_SRC" ]; then
    echo ""
    echo -e "${RED}======================================${NC}"
    echo -e "${RED}  E2E cannot run against this tree${NC}"
    echo -e "${RED}======================================${NC}"
    echo ""
    echo "pytest's interpreter gets elspais from:"
    echo "  ${E2E_ENV_SRC:-<nowhere: it cannot import elspais>}"
    echo "This tree is:"
    echo "  $E2E_REPO_SRC"
    echo ""
    echo "A run here would describe that install, not this branch."
    echo "Build this worktree's venv:"
    echo "  python3 -m venv .venv && .venv/bin/pip install -e \".[all,mcp,dev]\""
    echo ""
    exit 1
fi

# Honor a verdict already recorded for this tree in this environment. The
# cache records the verdict for a tree, not just its successes: caching only
# passes meant any failing run guaranteed every subsequent push re-ran the
# whole suite and died the same way.
if [ -z "$ELSPAIS_E2E_FORCE" ] && [ -f "$E2E_CACHE" ]; then
    CACHED_HASH=$(cut -d' ' -f1 < "$E2E_CACHE")
    CACHED_VERDICT=$(cut -d' ' -f2 < "$E2E_CACHE")
    CACHED_ENV=$(cut -d' ' -f3 < "$E2E_CACHE")
    if [ "$CACHED_HASH" = "$CONTENT_HASH" ] && [ -n "$CACHED_ENV" ] \
       && [ "$CACHED_ENV" = "$E2E_ENV_SRC" ]; then
        if [ "$CACHED_VERDICT" = "PASS" ]; then
            echo -e "${GREEN}E2E tests cached — passed since last change${NC}"
            exit 0
        fi
        echo -e "${RED}E2E tests failed (cached verdict for an unchanged tree)${NC}"
        echo "Re-run them with: ELSPAIS_E2E_FORCE=1 .githooks/e2e-verdict"
        echo "Cache: $E2E_CACHE"
        exit 1
    fi
fi

# The path and the junit family the `elspais-e2e` target declares in
# .elspais.toml. The configuration is the authority on what this project's e2e
# results ARE; this hook is one way of producing them, so it produces them
# where they are declared to be. Written under any other name, the artifact is
# one `elspais checks` never opens -- and the tier reports as not having run to
# the one person who just ran it. `junit_family=xunit1` is not cosmetic either:
# it is what keeps the per-testcase file/line attributes the source matcher
# binds on, which is the line-level linking the pretty-print below exists for.
E2E_RESULTS="$CACHE_DIR/junit-e2e.xml"

# The tier runs detached, so a push whose client times out — or a hook killed
# for any other reason — loses the connection and not the run. The verdict,
# and the artifact elspais reads, are recorded by the run itself: a verdict
# earned must survive the death of whoever was waiting for it. Pushing again
# attaches to a run still going, or hits the verdict one already recorded.
E2E_RUN_DIR="$CACHE_DIR/run-e2e"
mkdir -p "$E2E_RUN_DIR"

E2E_NOVERDICT="$E2E_RUN_DIR/noverdict"

# The runner, resolved once, here, where the probe above has just shown it is
# the one this tree means. Handing the run its absolute path closes the window
# in which a PATH lookup at run time could find another, or none.
PYTEST_BIN=$(command -v pytest)

# A verdict is a statement about a run that tested this tree. The finisher
# derives it from the report the run wrote as well as from its exit code, and
# records NOTHING where either says no tests ran -- pytest not found (127) or
# not executable (126), the tree unreachable (99), a usage or internal error
# (4, 3), nothing collected (5), an interrupt (2, with no failure or error in
# its report) or a signal, or a report that is missing, empty or unreadable.
# Exit 2 with errors in the report is a collection error -- a module that
# will not import on this tree -- and is recorded as FAIL. Caching FAIL for such a run would block every
# later push of an unchanged tree over an environment fault, and caching PASS
# would certify code nobody tested. FAIL is written only for a run whose
# report holds failures.
#
# Written only when no run is in progress: a run already going calls the
# finisher it started with at its end, and one for another tree must not have
# its verdict recorded under this tree's key.
write_finisher() {
{
    printf '#!/bin/bash\n'
    printf '# Records the e2e verdict, and formats the artifact it was read from.\n'
    printf 'RESULTS=%q\n' "$E2E_RESULTS"
    printf 'CACHE=%q\n' "$E2E_CACHE"
    printf 'MARKER=%q\n' "$E2E_NOVERDICT"
    printf 'KEY_HASH=%q\n' "$CONTENT_HASH"
    printf 'KEY_ENV=%q\n' "$E2E_ENV_SRC"
    cat <<'FINISH'
rc="$1"
rm -f "$MARKER"
no_verdict() {
    echo "no-verdict: $1 (rc $rc); the cache is left as it was"
    printf '%s (rc %s)\n' "$1" "$rc" > "$MARKER"
    exit 0
}
case "$rc" in
    # 2 is both an interrupt and a collection error -- a test module that will
    # not import on this tree. Only the report tells them apart, so it is read
    # below: errors in it are a verdict about the code, none is an interrupt.
    0|1|2) ;;
    99) no_verdict "the run could not change to the repository root" ;;
    126) no_verdict "pytest could not be executed" ;;
    127) no_verdict "pytest was not found" ;;
    3) no_verdict "pytest hit an internal error" ;;
    4) no_verdict "pytest was invoked wrongly (usage error)" ;;
    5) no_verdict "pytest collected no tests" ;;
    *)
        if [ "$rc" -gt 128 ]; then
            no_verdict "pytest was stopped by signal $((rc - 128))"
        fi
        no_verdict "pytest exited with an unrecognised code"
        ;;
esac
if [ ! -s "$RESULTS" ]; then
    no_verdict "the run wrote no junit report at $RESULTS"
fi
failures=$(python3 - "$RESULTS" <<'PY'
import sys
import xml.etree.ElementTree as ET

path = sys.argv[1]
try:
    tree = ET.parse(path)
except (ET.ParseError, OSError):
    sys.exit(2)
root = tree.getroot()
failed = sum(
    1 for case in root.iter("testcase")
    if case.find("failure") is not None or case.find("error") is not None
)
if not failed:
    for suite in root.iter("testsuite"):
        for attribute in ("failures", "errors"):
            try:
                failed += int(suite.get(attribute) or 0)
            except ValueError:
                pass
# Formatting only: the per-testcase file/line attributes are what the source
# matcher binds on, and an indented report is what a reader opens.
try:
    ET.indent(tree, space="  ")
    tree.write(path, encoding="unicode", xml_declaration=True)
except OSError:
    print("::warning::junit pretty-print failed (tolerated: artifact formatting only)",
          file=sys.stderr)
print(failed)
PY
) || no_verdict "the junit report at $RESULTS did not parse"
if [ "$rc" -eq 0 ] && [ "$failures" -eq 0 ]; then
    printf '%s PASS %s\n' "$KEY_HASH" "$KEY_ENV" > "$CACHE"
elif [ "$rc" -ne 0 ] && [ "$failures" -gt 0 ]; then
    printf '%s FAIL %s\n' "$KEY_HASH" "$KEY_ENV" > "$CACHE"
elif [ "$rc" -eq 2 ]; then
    no_verdict "pytest was interrupted before any test failed"
else
    no_verdict "pytest's exit code disagrees with its report, which holds $failures failure(s)"
fi
FINISH
} > "$E2E_RUN_DIR/finish.sh"
}

# A new run starts without the previous run's report, so a run that writes
# none cannot leave an earlier one to be read -- by the finisher or by
# `elspais checks` -- as its own. A run already in progress keeps its report.
if ! tier_run_alive "$E2E_RUN_DIR"; then
    rm -f "$E2E_RESULTS" "$E2E_NOVERDICT"
    write_finisher
fi

E2E_RC=$(tier_execute "$E2E_RUN_DIR" "$CONTENT_HASH $E2E_ENV_SRC" "$REPO_ROOT" "e2e" \
    "$E2E_RUN_DIR/finish.sh" \
    "$PYTEST_BIN" tests/ -m "e2e" --tb=short -q \
    --junitxml="$E2E_RESULTS" -o junit_family=xunit1)

if [ -f "$E2E_NOVERDICT" ]; then
    echo -e "${RED}The e2e run produced no verdict: $(cat "$E2E_NOVERDICT")${NC}"
    echo "Nothing was recorded for this tree. The run's output is in $E2E_RUN_DIR/log."
    exit 1
fi

if [ "$E2E_RC" = "137" ]; then
    echo -e "${RED}The e2e run ended without recording a verdict.${NC}"
    echo "Its output is in $E2E_RUN_DIR/log. Run this again to re-run;"
    echo "a run still in progress will be waited on rather than duplicated."
    exit 1
fi

if [ "$E2E_RC" != "0" ]; then
    echo -e "${RED}E2E tests failed!${NC}"
    exit 1
fi
echo -e "${GREEN}E2E tests passed!${NC}"
