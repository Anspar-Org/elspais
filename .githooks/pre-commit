#!/bin/bash
# =====================================================
# Pre-Commit Hook: elspais
# =====================================================
#
# Validates code quality before commits:
#   - Branch protection (blocks commits to main/master)
#   - Unstaged src/tests changes (prevents partial commits)
#   - Python code quality (ruff: lint + format)
#   - Markdown linting (markdownlint)
#   - elspais fix (regenerate INDEX.md, hashes, spec/_generated), staging what it wrote
#   - Unit/integration tests with coverage (last — most expensive), through
#     .githooks/unit-verdict. ELSPAIS_CHECKPOINT=1 defers them to pre-push.
#
# To install this hook:
#   make setup   (or: git config core.hooksPath .githooks)
#
# To bypass (NOT RECOMMENDED):
#   git commit --no-verify
#
# =====================================================

set -e

# Git sets GIT_DIR when invoking hooks — this causes subprocess git
# commands in tests to silently operate on this repo instead of their
# temp directories.  Unset it so pytest child processes get a clean env.
unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
unset GIT_AUTHOR_NAME
unset GIT_AUTHOR_EMAIL
unset GIT_AUTHOR_DATE
unset GIT_COMMITTER_NAME
unset GIT_COMMITTER_EMAIL
unset GIT_COMMITTER_DATE

# =====================================================
# 0. Resolve the CLI this tree means
# =====================================================
# The stages below invoke `elspais` and `pytest` by name. If PATH resolves
# them to a global install (pipx, ~/.local/bin) or another worktree's venv,
# the hook validates that software instead of this tree — and `elspais fix`
# run from a different version rewrites every hash in this repo's own spec
# estate. Prefer the worktree's venv when its code is this tree's code, and
# say so when it is not, so the mismatch is visible rather than silent.
# pre-push carries the same guard for the e2e stage.

HOOK_REPO_ROOT=$(git rev-parse --show-toplevel)

# A console-script shebang is not reliably `#!<absolute-path-to-python>`: some
# layouts write `#!/usr/bin/env python3`, and options may follow the
# interpreter. So walk the shebang's words, step over the `env` trampoline and
# any flags, and resolve a bare name through PATH as `env` itself would. An
# interpreter that cannot be identified yields no answer rather than a wrong
# one, and every caller below treats "no answer" as "not this tree" — the safe
# direction, since the only thing gated on it is a destructive write.
hook_cli_src() {
    _bin=$(command -v elspais 2>/dev/null) || return 1
    _shebang=$(head -1 "$_bin" 2>/dev/null) || return 1
    case "$_shebang" in
        '#!'*) ;;
        *) return 1 ;;
    esac

    _py=""
    for _word in ${_shebang#\#!}; do
        case "$_word" in
            -*) continue ;;
        esac
        case "$(basename "$_word")" in
            env) continue ;;
        esac
        case "$_word" in
            /*) _py="$_word" ;;
            *)  _py=$(command -v "$_word" 2>/dev/null) || _py="" ;;
        esac
        if [ -n "$_py" ]; then break; fi
    done

    [ -n "$_py" ] || return 1
    [ -x "$_py" ] || return 1
    "$_py" -c 'import elspais,os;print(os.path.realpath(os.path.dirname(elspais.__file__)))' 2>/dev/null
}

# `set -e` is in force, and `VAR=$(fn)` adopts the function's exit status — so
# an unset fallback here would abort the whole hook the moment `elspais` is not
# installed, silently and before any other check runs. `elspais` is optional to
# this hook; not finding it must stay a fact it can act on, not a fatal error.
HOOK_REPO_SRC=$(cd "$HOOK_REPO_ROOT" && python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "src/elspais") \
    || HOOK_REPO_SRC="$HOOK_REPO_ROOT/src/elspais"

# Prefer the worktree's venv always, not only where the `elspais` launcher
# resolves elsewhere. This hook also runs pytest, whose tests re-enter a
# fresh interpreter that inherits no sys.path, and the launcher and the
# interpreter are separate installs that routinely disagree -- so a repair
# keyed on the launcher leaves pytest running under whatever is on PATH.
if [ -d "$HOOK_REPO_ROOT/.venv/bin" ]; then
    PATH="$HOOK_REPO_ROOT/.venv/bin:$PATH"
    export PATH
fi

HOOK_CLI_SRC=$(hook_cli_src) || HOOK_CLI_SRC=""

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# =====================================================
# 1. Branch Protection - Block Commits to Main
# =====================================================

CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
    echo -e "${RED}ERROR: Direct commits to '$CURRENT_BRANCH' branch are not allowed!${NC}"
    echo ""
    echo "This repository enforces a feature branch workflow."
    echo "All changes must go through pull requests."
    echo ""
    echo "To fix this:"
    echo "  1. Create a feature branch: git checkout -b fix/your-fix-name"
    echo "  2. Commit your changes to the feature branch"
    echo "  3. Push and create a pull request"
    echo ""
    exit 1
fi

# =====================================================
# 2. Unstaged Changes in src/ or tests/
# =====================================================

UNSTAGED_SRC_TESTS=$(git diff --name-only -- src/ tests/ 2>/dev/null) || UNSTAGED_SRC_TESTS=""

if [ -n "$UNSTAGED_SRC_TESTS" ]; then
    echo -e "${RED}ERROR: Unstaged changes detected in src/ or tests/:${NC}"
    echo "$UNSTAGED_SRC_TESTS" | sed 's/^/  /'
    echo ""
    echo "Stage them (git add) or stash them (git stash -k) before committing."
    exit 1
fi

# =====================================================
# 3. Python Code Quality (ruff lint + format, whole tree)
# =====================================================
# Checks ALL of src/ and tests/, not only the files staged in this commit.
# Change-scoped checks let drift accumulate invisibly (e.g. via --no-verify
# or hook-less clones) until it blocks an unrelated commit.

STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$') || STAGED_PYTHON_FILES=""

echo -e "${BLUE}Checking Python code quality (whole tree)...${NC}"
echo ""

PYTHON_FAILED=false

# Run ruff if available
if command -v ruff &> /dev/null; then
    echo "  Running ruff check on src/ tests/..."
    if ! ruff check src/ tests/ 2>&1; then
        PYTHON_FAILED=true
        echo -e "${RED}  ruff check failed${NC}"
    else
        echo -e "${GREEN}  ruff check passed${NC}"
    fi
else
    echo -e "${YELLOW}  WARNING: ruff not installed - skipping${NC}"
fi

# Run the formatter. ruff is both the linter above and the formatter here;
# there is no second formatter to disagree with it.
if command -v ruff &> /dev/null; then
    echo "  Running ruff format check on src/ tests/..."
    if ! ruff format --check --quiet src/ tests/ 2>&1; then
        # Auto-fix is offered only for files staged in this commit
        if [ -n "$STAGED_PYTHON_FILES" ]; then
            echo -e "${YELLOW}  Files need formatting. Applying fixes to staged files...${NC}"
            echo "$STAGED_PYTHON_FILES" | xargs ruff format
            echo "$STAGED_PYTHON_FILES" | xargs git add
            echo -e "${GREEN}  Formatted files have been re-staged${NC}"
        fi
        # Anything still unformatted is drift outside this commit — fail loudly
        if ! ruff format --check src/ tests/ 2>&1; then
            PYTHON_FAILED=true
            echo -e "${RED}  ruff format check failed on files outside this commit${NC}"
            echo "  Run 'ruff format src/ tests/' and commit the result."
        else
            echo -e "${GREEN}  ruff format check passed after formatting staged files${NC}"
        fi
    else
        echo -e "${GREEN}  ruff format check passed${NC}"
    fi
fi

if [ "$PYTHON_FAILED" = true ]; then
    echo ""
    echo -e "${RED}Python code quality checks failed!${NC}"
    echo "Fix the errors above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    exit 1
fi

echo ""

# =====================================================
# 4. Markdown Linting
# =====================================================

MARKDOWN_FILES_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$') || MARKDOWN_FILES_CHANGED=""

if [ -n "$MARKDOWN_FILES_CHANGED" ]; then
    echo -e "${BLUE}Linting markdown files...${NC}"
    echo ""

    if command -v markdownlint &> /dev/null; then
        # Check if config exists
        MDLINT_CONFIG=""
        if [ -f ".markdownlint.json" ]; then
            MDLINT_CONFIG="--config .markdownlint.json"
        fi

        if ! echo "$MARKDOWN_FILES_CHANGED" | xargs markdownlint $MDLINT_CONFIG 2>&1; then
            echo ""
            echo -e "${RED}Markdown linting failed!${NC}"
            echo "Fix the errors above before committing."
            echo ""
            echo "To bypass this check (NOT RECOMMENDED):"
            echo "  git commit --no-verify"
            exit 1
        fi

        echo -e "${GREEN}Markdown linting passed!${NC}"
        echo ""
    else
        echo -e "${YELLOW}WARNING: markdownlint not installed - skipping${NC}"
        echo "  Install: npm install -g markdownlint-cli"
        echo ""
    fi
fi

# =====================================================
# 5. elspais fix, staging what it wrote
# =====================================================

if command -v elspais &> /dev/null; then
    # `elspais fix` rewrites this repo's spec estate in place, and the hashes
    # it writes are the ones its own version computes. Running a different
    # version against elspais's own spec tree rewrites every hash in it, which
    # reads as an authored change and is laborious to unpick. A CLI that is not
    # this tree cannot be trusted with that write.
    if [ "$HOOK_CLI_SRC" != "$HOOK_REPO_SRC" ]; then
        echo -e "${RED}ERROR: elspais on PATH is ${HOOK_CLI_SRC:-<not importable>},${NC}"
        echo -e "${RED}       not this tree ($HOOK_REPO_SRC).${NC}"
        echo ""
        echo "'elspais fix' from another version would rewrite every hash in"
        echo "this repo's spec estate. Refusing to run it."
        echo ""
        echo "To fix, create a venv for this worktree:"
        echo "  python3 -m venv .venv && .venv/bin/pip install -e \".[all,mcp,dev]\""
        echo "This hook prefers \$REPO_ROOT/.venv/bin automatically once it exists."
        exit 1
    fi

    # What `elspais fix` writes -- spec/INDEX.md, hash footers and changelog
    # lines in spec files, spec/_generated/* -- belongs in this commit, so it
    # is staged here. The paths are read off the working tree rather than
    # listed, because fix decides which files it rewrites. A path that already
    # held unstaged edits before fix ran is left unstaged: staging it would
    # also commit edits the author did not stage.
    _unstaged_paths() {
        git diff --name-only
        git ls-files --others --exclude-standard
    }
    # Each unstaged path with the digest of its working-tree content, so a
    # path fix rewrote can be told from one it left alone.
    _unstaged_digests() {
        _unstaged_paths | sort -u | while IFS= read -r _path; do
            if [ -f "$_path" ]; then
                printf '%s %s\n' "$(git hash-object -- "$_path")" "$_path"
            else
                printf 'absent %s\n' "$_path"
            fi
        done
    }
    _before_fix=$(_unstaged_paths | sort -u)
    _before_digests=$(_unstaged_digests)

    echo -e "${BLUE}Running elspais fix...${NC}"
    if elspais fix 2>&1; then
        _after_fix=$(_unstaged_paths | sort -u)
        _fix_wrote=$(comm -13 <(printf '%s\n' "$_before_fix") <(printf '%s\n' "$_after_fix") | sed '/^$/d')
        # A path unstaged both before and after whose content fix changed.
        _held_back=$(comm -13 <(printf '%s\n' "$_before_digests" | sort) <(_unstaged_digests | sort) \
            | cut -d' ' -f2- | sort -u \
            | comm -12 <(printf '%s\n' "$_before_fix") - | sed '/^$/d')
        if [ -n "$_fix_wrote" ]; then
            printf '%s\n' "$_fix_wrote" | while IFS= read -r _path; do
                git add -- "$_path"
                echo -e "  staged ${_path}"
            done
        fi
        if [ -n "$_held_back" ]; then
            echo -e "${YELLOW}  Not staged (held unstaged edits before elspais fix ran):${NC}"
            printf '%s\n' "$_held_back" | sed 's/^/    /'
        fi
        echo -e "${GREEN}elspais fix passed${NC}"
    else
        echo -e "${RED}elspais fix failed!${NC}"
        exit 1
    fi
    echo ""
else
    echo -e "${YELLOW}WARNING: elspais not installed - skipping fix${NC}"
    echo ""
fi

# =====================================================
# 6. Unit/Integration Tests with Coverage (cached)
# =====================================================

# .githooks/unit-verdict is the one authority for the unit verdict, and it
# runs the tier through .githooks/run-unit-tier. A checkpoint commit
# (ELSPAIS_CHECKPOINT=1) defers the tier: it records no verdict for its tree,
# so pre-push runs the tier for the tree it pushes. Every gate above still ran.
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ "${ELSPAIS_CHECKPOINT:-}" = "1" ]; then
    echo -e "${YELLOW}Checkpoint commit: unit tests deferred to pre-push${NC}"
    echo ""
elif ! "$REPO_ROOT/.githooks/unit-verdict"; then
    echo ""
    echo "Fix the errors above before committing, or commit a checkpoint"
    echo "(ELSPAIS_CHECKPOINT=1 git commit ...) whose tests pre-push will run."
    exit 1
else
    echo ""
fi

# =====================================================
# 7. All Validations Passed
# =====================================================

echo -e "${GREEN}Pre-commit checks passed!${NC}"
exit 0
