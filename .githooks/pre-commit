#!/bin/bash
# =====================================================
# Pre-Commit Hook: elspais
# =====================================================
#
# Validates code quality before commits:
#   - Branch protection (blocks commits to main/master)
#   - Unstaged src/tests changes (prevents partial commits)
#   - Python code quality (ruff + black)
#   - Markdown linting (markdownlint)
#   - elspais fix (regenerate INDEX.md, KNOWN_ISSUES.md)
#   - Unit/integration tests with coverage (last — most expensive)
#
# To install this hook:
#   make setup   (or: git config core.hooksPath .githooks)
#
# To bypass (NOT RECOMMENDED):
#   git commit --no-verify
#
# =====================================================

set -e

# Git sets GIT_DIR when invoking hooks — this causes subprocess git
# commands in tests to silently operate on this repo instead of their
# temp directories.  Unset it so pytest child processes get a clean env.
unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
unset GIT_AUTHOR_NAME
unset GIT_AUTHOR_EMAIL
unset GIT_AUTHOR_DATE
unset GIT_COMMITTER_NAME
unset GIT_COMMITTER_EMAIL
unset GIT_COMMITTER_DATE

# =====================================================
# 0. Resolve the CLI this tree means
# =====================================================
# The stages below invoke `elspais` and `pytest` by name. If PATH resolves
# them to a global install (pipx, ~/.local/bin) or another worktree's venv,
# the hook validates that software instead of this tree — and `elspais fix`
# run from a different version rewrites every hash in this repo's own spec
# estate. Prefer the worktree's venv when its code is this tree's code, and
# say so when it is not, so the mismatch is visible rather than silent.
# pre-push carries the same guard for the e2e stage.

HOOK_REPO_ROOT=$(git rev-parse --show-toplevel)

hook_cli_src() {
    _bin=$(command -v elspais 2>/dev/null) || return 1
    _py=$(head -1 "$_bin" 2>/dev/null | sed 's|^#!||')
    [ -x "$_py" ] || return 1
    "$_py" -c 'import elspais,os;print(os.path.realpath(os.path.dirname(elspais.__file__)))' 2>/dev/null
}

HOOK_REPO_SRC=$(cd "$HOOK_REPO_ROOT" && python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "src/elspais")

if [ "$(hook_cli_src)" != "$HOOK_REPO_SRC" ] && [ -x "$HOOK_REPO_ROOT/.venv/bin/elspais" ]; then
    PATH="$HOOK_REPO_ROOT/.venv/bin:$PATH"
    export PATH
fi

HOOK_CLI_SRC=$(hook_cli_src)

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# =====================================================
# 1. Branch Protection - Block Commits to Main
# =====================================================

CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
    echo -e "${RED}ERROR: Direct commits to '$CURRENT_BRANCH' branch are not allowed!${NC}"
    echo ""
    echo "This repository enforces a feature branch workflow."
    echo "All changes must go through pull requests."
    echo ""
    echo "To fix this:"
    echo "  1. Create a feature branch: git checkout -b fix/your-fix-name"
    echo "  2. Commit your changes to the feature branch"
    echo "  3. Push and create a pull request"
    echo ""
    exit 1
fi

# =====================================================
# 2. Unstaged Changes in src/ or tests/
# =====================================================

UNSTAGED_SRC_TESTS=$(git diff --name-only -- src/ tests/ 2>/dev/null) || UNSTAGED_SRC_TESTS=""

if [ -n "$UNSTAGED_SRC_TESTS" ]; then
    echo -e "${RED}ERROR: Unstaged changes detected in src/ or tests/:${NC}"
    echo "$UNSTAGED_SRC_TESTS" | sed 's/^/  /'
    echo ""
    echo "Stage them (git add) or stash them (git stash -k) before committing."
    exit 1
fi

# =====================================================
# 3. Python Code Quality (ruff + black, whole tree)
# =====================================================
# Checks ALL of src/ and tests/, not only the files staged in this commit.
# Change-scoped checks let drift accumulate invisibly (e.g. via --no-verify
# or hook-less clones) until it blocks an unrelated commit.

STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$') || STAGED_PYTHON_FILES=""

echo -e "${BLUE}Checking Python code quality (whole tree)...${NC}"
echo ""

PYTHON_FAILED=false

# Run ruff if available
if command -v ruff &> /dev/null; then
    echo "  Running ruff check on src/ tests/..."
    if ! ruff check src/ tests/ 2>&1; then
        PYTHON_FAILED=true
        echo -e "${RED}  ruff check failed${NC}"
    else
        echo -e "${GREEN}  ruff check passed${NC}"
    fi
else
    echo -e "${YELLOW}  WARNING: ruff not installed - skipping${NC}"
fi

# Run black if available
if command -v black &> /dev/null; then
    echo "  Running black check on src/ tests/..."
    if ! black --check --quiet src/ tests/ 2>&1; then
        # Auto-fix is offered only for files staged in this commit
        if [ -n "$STAGED_PYTHON_FILES" ]; then
            echo -e "${YELLOW}  Files need formatting. Applying fixes to staged files...${NC}"
            echo "$STAGED_PYTHON_FILES" | xargs black
            echo "$STAGED_PYTHON_FILES" | xargs git add
            echo -e "${GREEN}  Formatted files have been re-staged${NC}"
        fi
        # Anything still unformatted is drift outside this commit — fail loudly
        if ! black --check src/ tests/ 2>&1; then
            PYTHON_FAILED=true
            echo -e "${RED}  black check failed on files outside this commit${NC}"
            echo "  Run 'black src/ tests/' and commit the result."
        else
            echo -e "${GREEN}  black check passed after formatting staged files${NC}"
        fi
    else
        echo -e "${GREEN}  black check passed${NC}"
    fi
else
    echo -e "${YELLOW}  WARNING: black not installed - skipping${NC}"
fi

if [ "$PYTHON_FAILED" = true ]; then
    echo ""
    echo -e "${RED}Python code quality checks failed!${NC}"
    echo "Fix the errors above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    exit 1
fi

echo ""

# =====================================================
# 4. Markdown Linting
# =====================================================

MARKDOWN_FILES_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$') || MARKDOWN_FILES_CHANGED=""

if [ -n "$MARKDOWN_FILES_CHANGED" ]; then
    echo -e "${BLUE}Linting markdown files...${NC}"
    echo ""

    if command -v markdownlint &> /dev/null; then
        # Check if config exists
        MDLINT_CONFIG=""
        if [ -f ".markdownlint.json" ]; then
            MDLINT_CONFIG="--config .markdownlint.json"
        fi

        if ! echo "$MARKDOWN_FILES_CHANGED" | xargs markdownlint $MDLINT_CONFIG 2>&1; then
            echo ""
            echo -e "${RED}Markdown linting failed!${NC}"
            echo "Fix the errors above before committing."
            echo ""
            echo "To bypass this check (NOT RECOMMENDED):"
            echo "  git commit --no-verify"
            exit 1
        fi

        echo -e "${GREEN}Markdown linting passed!${NC}"
        echo ""
    else
        echo -e "${YELLOW}WARNING: markdownlint not installed - skipping${NC}"
        echo "  Install: npm install -g markdownlint-cli"
        echo ""
    fi
fi

# =====================================================
# 5. elspais fix (regenerate INDEX.md, KNOWN_ISSUES.md)
# =====================================================

if command -v elspais &> /dev/null; then
    # `elspais fix` rewrites this repo's spec estate in place, and the hashes
    # it writes are the ones its own version computes. Running a different
    # version against elspais's own spec tree rewrites every hash in it, which
    # reads as an authored change and is laborious to unpick. A CLI that is not
    # this tree cannot be trusted with that write.
    if [ "$HOOK_CLI_SRC" != "$HOOK_REPO_SRC" ]; then
        echo -e "${RED}ERROR: elspais on PATH is ${HOOK_CLI_SRC:-<not importable>},${NC}"
        echo -e "${RED}       not this tree ($HOOK_REPO_SRC).${NC}"
        echo ""
        echo "'elspais fix' from another version would rewrite every hash in"
        echo "this repo's spec estate. Refusing to run it."
        echo ""
        echo "To fix, create a venv for this worktree:"
        echo "  python3 -m venv .venv && .venv/bin/pip install -e \".[all,mcp,dev]\""
        echo "This hook prefers \$REPO_ROOT/.venv/bin automatically once it exists."
        exit 1
    fi

    echo -e "${BLUE}Running elspais fix...${NC}"
    if elspais fix 2>&1; then
        # Stage any regenerated files (tolerated failure: paths may not exist yet)
        if ! git add -u spec/INDEX.md KNOWN_ISSUES.md 2>/dev/null; then
            echo -e "${YELLOW}  Note: no regenerated spec/INDEX.md or KNOWN_ISSUES.md to stage${NC}"
        fi
        echo -e "${GREEN}elspais fix passed${NC}"
    else
        echo -e "${RED}elspais fix failed!${NC}"
        exit 1
    fi
    echo ""
else
    echo -e "${YELLOW}WARNING: elspais not installed - skipping fix${NC}"
    echo ""
fi

# =====================================================
# 6. Unit/Integration Tests with Coverage (cached)
# =====================================================

REPO_ROOT=$(git rev-parse --show-toplevel)
CACHE_DIR="$REPO_ROOT/.results"
UNIT_CACHE="$CACHE_DIR/.test-cache-unit"

mkdir -p "$CACHE_DIR"

# Compute content hash from the staged index (what the commit will contain).
# An empty hash (write-tree failure) must never be used as a cache key: a
# recorded "" would match the next failure's "" and skip tests forever.
CONTENT_HASH=$(git write-tree 2>/dev/null | head -c 40) || CONTENT_HASH=""
if [ -z "$CONTENT_HASH" ]; then
    echo -e "${YELLOW}WARNING: git write-tree produced no hash — test cache disabled for this run${NC}"
fi

if [ -n "$CONTENT_HASH" ] && [ -f "$UNIT_CACHE" ] && [ "$(cat "$UNIT_CACHE" 2>/dev/null)" = "$CONTENT_HASH" ]; then
    echo -e "${GREEN}Tests cached — no changes since last pass${NC}"
    echo ""
else
    echo -e "${BLUE}Running unit/integration tests with coverage...${NC}"
    echo ""

    if ! pytest tests/ --tb=short -q \
        --junitxml="$CACHE_DIR/junit.xml" -o junit_family=xunit1 \
        --cov=src/elspais --cov-context=test --cov-report=json:"$CACHE_DIR/coverage.json" --cov-report= 2>&1; then
        echo ""
        echo -e "${RED}Tests failed!${NC}"
        echo "Fix the errors above before committing."
        echo ""
        echo "To bypass this check (NOT RECOMMENDED):"
        echo "  git commit --no-verify"
        rm -f "$UNIT_CACHE"
        exit 1
    fi

    echo -e "${GREEN}Tests passed!${NC}"
    if [ -n "$CONTENT_HASH" ]; then
        echo "$CONTENT_HASH" > "$UNIT_CACHE"
    else
        # No trustworthy key for this pass — drop any stale cache instead
        rm -f "$UNIT_CACHE"
    fi
    echo ""
fi

# =====================================================
# 7. All Validations Passed
# =====================================================

echo -e "${GREEN}Pre-commit checks passed!${NC}"
exit 0
