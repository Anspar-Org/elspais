# Developer-local config overrides
.elspais.local.toml

# Daemon state files (any directory depth)
.elspais/daemon.*
**/.elspais/daemon.*

# Record of a save the daemon performed itself: local process state that
# describes this checkout's working tree, not something to share.
.elspais/automatic-save.json
**/.elspais/automatic-save.json
# The address a working tree is served at. Machine-local, and not matched
# by the daemon.* patterns above.
.elspais/daemon-port.json
**/.elspais/daemon-port.json

# Sentinels for changes a server is holding, and for changes a dead one
# was holding. Same reason: one checkout's process state.
.elspais/unsaved-changes
**/.elspais/unsaved-changes
.elspais/lost-changes
**/.elspais/lost-changes

