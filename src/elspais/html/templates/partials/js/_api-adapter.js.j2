// Partial: _api-adapter.js.j2 — Unified apiFetch() adapter
{# Implements: REQ-p00006-A, REQ-p00006-B, REQ-p00006-C #}
//
// Edit mode: delegates to real fetch() for live API calls.
// View mode: routes URL patterns to embedded JSON data.

{% if mode == 'edit' %}
// ── Edit mode: real API calls ──
var _embeddedData = null;
var _lastClickedButton = null;

// Track the last button clicked for automatic busy state
document.addEventListener('click', function(e) {
    var btn = e.target.closest('button');
    if (btn) _lastClickedButton = btn;
}, true);

// This page's own writes, so that a change the server announces can be
// told from another writer's. The server sees the mutation-log tip move
// the instant a write lands; this page adopts the tip only once the
// response and its count probe have come back, and judged in between,
// its own edit would read as somebody else's. Read by the change stream.
var _ownWritesInFlight = 0;
var _lastOwnWriteAt = 0;
{# Implements: REQ-o00079-C #}
function ownWriteRecently(withinMs) {
    return _ownWritesInFlight > 0 || (Date.now() - _lastOwnWriteAt) < withinMs;
}

{# Implements: REQ-d00295-B #}
// Every caller names a route from the server's root ('/api/...'); the
// prefix the server is mounted under is prepended HERE, once, so no
// caller carries it and none can forget it. A caller that already
// prefixed would be prefixed twice — callers pass root-relative URLs only.
function prefixedUrl(url) {
    if (URL_PREFIX && url.charAt(0) === '/') return URL_PREFIX + url;
    return url;
}

async function apiFetch(url, options) {
    var busyBtn = _lastClickedButton;
    if (busyBtn) busyBtn.classList.add('busy');
    var isWrite = !!(options && options.method && options.method.toUpperCase() !== 'GET');
    if (isWrite) { _ownWritesInFlight += 1; _lastOwnWriteAt = Date.now(); }
    try {
        var resp = await fetch(prefixedUrl(url), options);
        var data = await resp.json();
        if (!resp.ok) {
            // A precondition rejection is a conversation, not a dead end: it
            // carries the current state so the caller can reconcile. Hand it
            // back with its status instead of collapsing it to a toast.
            if (data && data.code) {
                data._status = resp.status;
                return data;
            }
            if (data.error) {
                // A caller with somewhere of its own to put a refusal -- an
                // open dialog holding the work the refusal is about -- says
                // so and is handed the body. Everyone else gets the toast,
                // because a refusal with nowhere to go is worse than a
                // misplaced one.
                if (options && options.handlesRefusal) {
                    data._status = resp.status;
                    return data;
                }
                showToast(data.error, 'error');
                return null;
            }
        }
        return data;
    } catch (err) {
        showToast('Network error: ' + err.message, 'error');
        return null;
    } finally {
        if (isWrite) { _ownWritesInFlight -= 1; _lastOwnWriteAt = Date.now(); }
        if (busyBtn) busyBtn.classList.remove('busy');
        _lastClickedButton = null;
    }
}


{% else %}
// ── View mode: read from the embedded content ──
{# Implements: REQ-d00321-E #}
// The embedded content is one gzip-compressed JSON document spelled in
// base64. The browser's own DecompressionStream restores it, once, before
// the first answer is given.
function _restoreEmbeddedData() {
    var el = document.getElementById('embedded-data');
    var bin = atob((el ? el.textContent : '').trim());
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    var restored = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    return new Response(restored).text().then(function (text) { return JSON.parse(text); });
}
var _embeddedReady = _restoreEmbeddedData();
_embeddedReady.catch(function (err) {
    var note = document.createElement('div');
    note.id = 'embedded-data-error';
    note.setAttribute('role', 'alert');
    note.style.cssText = 'padding:8px 16px;background:#fde8e8;color:#8a1c1c;font-weight:600;';
    note.textContent = 'This page could not read its embedded content (' + err.message +
        '). Reading it needs a current browser.';
    document.body.insertBefore(note, document.body.firstChild);
});

{# Implements: REQ-d00321-A #}
// The embedded source of a file is carried once, as its highlighted lines.
// A line's plain text is that line with its markup removed and its
// character references resolved.
var _PLAIN_TEXT_DECODER = document.createElement('textarea');
function plainTextOfHighlightedLine(line) {
    _PLAIN_TEXT_DECODER.innerHTML = String(line || '').replace(/<[^>]*>/g, '');
    return _PLAIN_TEXT_DECODER.value;
}

function apiFetch(url) {
    return _embeddedReady.then(function (data) { return _answerFromEmbedded(data, url); });
}

function _answerFromEmbedded(_embeddedData, url) {
    var m;
    // /api/node/<id>
    if ((m = url.match(/\/api\/node\/(.+)/))) {
        var id = decodeURIComponent(m[1]);
        var node = _embeddedData.nodes[id];
        return Promise.resolve(node || null);
    }
    // /api/test-coverage/<id>
    if ((m = url.match(/\/api\/test-coverage\/(.+)/))) {
        var id = decodeURIComponent(m[1]);
        var entry = _embeddedData.coverage[id];
        return Promise.resolve(entry ? entry.test : null);
    }
    // /api/code-coverage/<id>
    if ((m = url.match(/\/api\/code-coverage\/(.+)/))) {
        var id = decodeURIComponent(m[1]);
        var entry = _embeddedData.coverage[id];
        return Promise.resolve(entry ? entry.code : null);
    }
    // /api/tree-data
    if (url === '/api/tree-data') {
        return Promise.resolve(_embeddedData.tree);
    }
    // /api/status
    if (url === '/api/status') {
        return Promise.resolve(_embeddedData.status);
    }
    // /api/file-content — route to embedded source-files data
    if (url.indexOf('/api/file-content') === 0) {
        var params = new URLSearchParams(url.split('?')[1] || '');
        var path = params.get('path') || '';
        var fileData = _embeddedData.sources[path];
        if (fileData) {
            var highlighted = fileData.lines || [];
            return Promise.resolve({
                lines: highlighted.map(plainTextOfHighlightedLine),
                highlighted_lines: highlighted,
                language: fileData.language || '',
                line_count: (fileData.lines || []).length,
                has_pending_mutations: false,
                pending_mutation_count: 0,
                affected_nodes: []
            });
        }
        return Promise.resolve(null);
    }
    // /api/requirement/<id> — same as /api/node/ for requirements
    if ((m = url.match(/\/api\/requirement\/(.+)/))) {
        var id = decodeURIComponent(m[1]);
        var node = _embeddedData.nodes[id];
        return Promise.resolve(node || null);
    }
    // /api/dirty — always clean in static mode
    if (url === '/api/dirty') {
        return Promise.resolve({dirty: false, mutation_count: 0});
    }
    // /api/search — basic client-side search in embedded nodes
    if (url.indexOf('/api/search') === 0) {
        var params = new URLSearchParams(url.split('?')[1] || '');
        var query = (params.get('q') || '').toLowerCase();
        if (!query) return Promise.resolve({results: []});
        var results = [];
        var nodes = _embeddedData.nodes;
        for (var key in nodes) {
            var n = nodes[key];
            if (n.kind === 'requirement') {
                var title = (n.title || '').toLowerCase();
                var id = (n.id || '').toLowerCase();
                if (title.indexOf(query) !== -1 || id.indexOf(query) !== -1) {
                    results.push({id: n.id, title: n.title, level: (n.properties || {}).level});
                }
            }
        }
        return Promise.resolve({results: results});
    }
    // Fallback: not available in static mode
    return Promise.resolve(null);
}
{% endif %}
