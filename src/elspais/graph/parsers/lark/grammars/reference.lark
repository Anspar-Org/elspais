// Reference grammar for code and test files.
//
// Parses comment-based requirement references:
//   # Implements: REQ-p00001, REQ-p00002
//   // Verifies: REQ-p00001-A
//
// A keyword, its colon and a list of references on one comment line is the
// only form that declares a relationship.  A comment opening with an
// identifier that no keyword introduces is recognised so it can be reported
// (REQ-d00272-O), and never read as a declaration.
//
// Pre-scan (function/class context tracking) is handled in Python,
// not in the grammar.
//
// Uses Earley parser with dynamic lexer.  Rule priorities guide
// disambiguation.
//
// Parameterized tokens (substituted by GrammarFactory):
//   __NAMESPACE__       e.g. "REQ"
//   __TYPE_PATTERN__    e.g. "p|o|d"
//   __DIGITS_PATTERN__  e.g. "\\d{1,5}"
//   __COMMENT_STYLES__  the ONE marker opening a comment in the language of
//                       the file this parser reads -- e.g. "\\#" for a
//                       shell-like file, "//" for a c-like one.  A language
//                       the named set does not cover substitutes "(?!)", which
//                       never matches, so no keyword is read in such a file.
//                       Built by graph/parsers/patterns.comment_style_fragment;
//                       never spelled here.
//   __IMPL_KEYWORDS__   e.g. "[Ii][Mm][Pp]...", matching any case
//   __VER_KEYWORDS__    e.g. "[Vv][Ee][Rr]...", matching any case
//   __KEYWORDS__        every keyword, case-insensitive, alternated

start: (_entry)*

// Each entry is a content line + newline, or a bare newline (blank line).
_entry: ref_line _NL
      | _NL

// Each line is either a reference or an ordinary line.
?ref_line: single_ref
         | bare_ref
         | unresolved_ref
         | other_line

// --- Single-line reference comment ---
// # Implements: REQ-p00001, REQ-p00002

single_ref.3: SINGLE_REF_LINE

// --- Comment opening with an identifier that no keyword introduces ---
// #   REQ-p00001
//
// Nothing here declares a relationship.  The line is recognised so that a
// relationship its author appears to intend and has not spelled is reported
// (REQ-d00272-O), and so that it can continue a list the line above left
// open (REQ-d00269-H).

bare_ref.3: BARE_REF_LINE

// --- Reference comment naming no configured identifier ---
// # Implements: WIDGET-42
//
// A reference whose target no repository of the federation claims is a
// fact about the estate its author needs to see, so the line is admitted
// here and reported as a broken reference rather than read as prose.

unresolved_ref.2: UNRESOLVED_REF_LINE

// --- Ordinary line (no reference) ---

other_line.1: TEXT

// ===================================================================
// Terminals
// ===================================================================

// Single-line reference: comment + keyword + refs (optional leading whitespace).
// Matches lines starting with either the configured namespace (e.g. REQ-) or
// the fixed JNY- prefix so that ``Verifies: JNY-OQ-Login-01/2`` is
// recognized even when no REQ ID appears on the line.
SINGLE_REF_LINE.5: /[ \t]*(?:__COMMENT_STYLES__)[ \t]*(?:__KEYWORDS__):[ \t]+(?:__NAMESPACE__[-_]|JNY-)[^\n]+/

// Comment whose first content is an identifier: comment + indented REQ-ID
// or JNY-ID.  No keyword opens it, so it declares nothing.
BARE_REF_LINE.4: /[ \t]*(?:__COMMENT_STYLES__)[ \t]+(?:__NAMESPACE__[-_]|JNY-)[^\n]+/

// Reference comment whose target names no configured identifier.  The colon
// must abut the keyword, and a full-length match here always loses to
// SINGLE_REF_LINE.
//
// What decides recognition is position, not the shape of the target.  A
// target no repository claims is by definition outside every configured
// grammar, so nothing about how it looks can say whether it was meant as a
// reference; only where it was written can.  The keyword must therefore be
// the first content of the comment -- a terminal spans a whole line, so a
// keyword appearing anywhere else in the line is left ordinary text -- and
// whatever follows the colon is the target, whatever it looks like.  That
// admits a foreign identifier with a lowercase namespace, which a
// shape-based rule cannot.
//
// Recognising a line is not resolving it.  What a target may *mean* is a
// list of references and nothing else, and that is decided in the
// transformer, over the target as a whole: a target this terminal admits
// and that grammar cannot account for resolves to nothing and is reported
// verbatim.
//
// Once a line is recognised, shape is what distinguishes the classes
// within it: content after the colon is optional here, so a keyword
// introducing nothing at all is admitted and reported rather than
// vanishing as ordinary text (REQ-d00272-H).
UNRESOLVED_REF_LINE.3: /[ \t]*(?:__COMMENT_STYLES__)[ \t]*(?:__KEYWORDS__):[ \t]*[^\n]*/

// Generic text (lowest priority)
TEXT.1: /[^\n]+/

_NL: /\n/
