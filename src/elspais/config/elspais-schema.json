        "digits": {
          "default": 5,
          "title": "Digits",
          "type": "integer"
        },
        "leading_zeros": {
          "default": true,
          "title": "Leading Zeros",
          "type": "boolean"
        },
        "pattern": {
          "default": "",
          "title": "Pattern",
          "type": "string"
        }
      },
      "title": "ComponentConfig",
      "type": "object"
    },
    "CoverageConfig": {
      "additionalProperties": false,
      "description": "Coverage severity configuration for all 5 dimensions.",
      "properties": {
        "implemented": {
          "$ref": "#/$defs/CoverageSeverityConfig"
        },
        "tested": {
          "$ref": "#/$defs/CoverageSeverityConfig"
        },
        "verified": {
          "$ref": "#/$defs/CoverageSeverityConfig"
        },
        "uat_coverage": {
          "$ref": "#/$defs/CoverageSeverityConfig"
        },
        "uat_verified": {
          "$ref": "#/$defs/CoverageSeverityConfig"
        },
        "uncredited_evidence": {
          "default": "error",
          "title": "Uncredited Evidence",
          "type": "string"
        },
        "external_test_failure": {
          "default": "warning",
          "title": "External Test Failure",
          "type": "string"
        },
        "status_words": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Status Words",
          "type": "object"
        }
      },
      "title": "CoverageConfig",
      "type": "object"
    },
    "CoverageSeverityConfig": {
      "additionalProperties": false,
      "description": "Severity mapping for a single coverage dimension's tier states.\n\nEach tier maps to a severity: 'ok', 'info', 'warning', or 'error'. Tiers\nare the unified vocabulary (REQ-d00258): full / partial / failing / missing.",
      "properties": {
        "full": {
          "default": "ok",
          "title": "Full",
          "type": "string"
        },
        "partial": {
          "default": "warning",
          "title": "Partial",
          "type": "string"
        },
        "failing": {
          "default": "error",
          "title": "Failing",
          "type": "string"
        },
        "missing": {
          "default": "error",
          "title": "Missing",
          "type": "string"
        }
      },
      "title": "CoverageSeverityConfig",
      "type": "object"
    },
    "DocsScanningConfig": {
      "additionalProperties": false,
      "properties": {
        "directories": {
          "items": {
            "type": "string"
          },
          "title": "Directories",
          "type": "array"
        },
        "file_patterns": {
          "items": {
            "type": "string"
          },
          "title": "File Patterns",
          "type": "array"
