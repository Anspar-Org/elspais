        "write_associates": {
          "default": false,
          "title": "Write Associates",
          "type": "boolean"
        },
        "index_associates": {
          "default": false,
          "title": "Index Associates",
          "type": "boolean"
        }
      },
      "title": "FederationConfig",
      "type": "object"
    },
    "FormatConfig": {
      "additionalProperties": false,
      "properties": {
        "require_hash": {
          "default": false,
          "title": "Require Hash",
