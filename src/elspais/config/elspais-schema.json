    "ReferenceSeverityConfig": {
      "additionalProperties": false,
      "description": "Severity for each class of reference fault, and for reference status.\n\nSeverity is chosen per class because the classes differ in what would\nresolve them: configuring a missing repository answers one and answers\nnothing about a line that never read as an identifier (REQ-d00269-F).",
      "properties": {
        "retired": {
          "default": "warning",
          "title": "Retired",
          "type": "string"
        },
        "provisional": {
          "default": "info",
          "title": "Provisional",
          "type": "string"
        },
        "aspirational": {
          "default": "info",
          "title": "Aspirational",
          "type": "string"
        },
        "malformed": {
          "default": "warning",
          "title": "Malformed",
          "type": "string"
        },
        "unknown_namespace": {
          "default": "info",
          "title": "Unknown Namespace",
          "type": "string"
        },
        "unknown_requirement": {
          "default": "error",
          "title": "Unknown Requirement",
          "type": "string"
        },
        "unknown_assertion": {
          "default": "error",
          "title": "Unknown Assertion",
          "type": "string"
        },
        "forbidden": {
          "default": "error",
          "title": "Forbidden",
          "type": "string"
        },
        "keyword_form": {
          "default": "warning",
          "title": "Keyword Form",
          "type": "string"
        },
        "identifier_form": {
          "default": "warning",
          "title": "Identifier Form",
          "type": "string"
        },
        "undeclared": {
          "default": "warning",
          "title": "Undeclared",
          "type": "string"
        }
      },
      "title": "ReferenceSeverityConfig",
      "type": "object"
    },
