    "CodeScanningConfig": {
      "additionalProperties": false,
      "properties": {
        "directories": {
          "items": {
            "type": "string"
          },
          "title": "Directories",
          "type": "array"
        },
        "file_patterns": {
          "items": {
            "type": "string"
          },
          "title": "File Patterns",
          "type": "array"
        },
        "skip_files": {
          "items": {
            "type": "string"
          },
          "title": "Skip Files",
          "type": "array"
        },
        "skip_dirs": {
