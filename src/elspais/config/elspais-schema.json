{
  "$defs": {
    "AssertionConfig": {
      "additionalProperties": false,
      "properties": {
        "label_style": {
          "default": "uppercase",
          "title": "Label Style",
          "type": "string"
        },
        "max_count": {
          "default": 26,
          "title": "Max Count",
          "type": "integer"
        },
        "zero_pad": {
          "default": false,
          "title": "Zero Pad",
          "type": "boolean"
        },
        "separator": {
          "default": "-",
          "maxLength": 1,
          "minLength": 1,
          "pattern": "^[^:]*$",
          "title": "Separator",
          "type": "string"
        },
        "multi_separator": {
          "default": "+",
          "maxLength": 1,
          "minLength": 1,
          "pattern": "^[^:]*$",
          "title": "Multi Separator",
          "type": "string"
        }
      },
      "title": "AssertionConfig",
      "type": "object"
    },
    "AssociateEntryConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "git": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "required": [
        "path",
        "namespace"
      ],
      "title": "AssociateEntryConfig",
      "type": "object"
    },
    "AssociatedPatternConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "position": {
          "default": "after_prefix",
          "title": "Position",
          "type": "string"
        },
        "format": {
          "default": "uppercase",
          "title": "Format",
          "type": "string"
        },
        "length": {
          "default": 3,
          "title": "Length",
          "type": "integer"
        },
        "separator": {
          "default": "-",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "AssociatedPatternConfig",
      "type": "object"
    },
    "ChangelogConfig": {
      "additionalProperties": false,
      "properties": {
        "hash_current": {
          "default": true,
          "title": "Hash Current",
          "type": "boolean"
        },
        "present": {
          "default": false,
          "title": "Present",
          "type": "boolean"
        },
        "id_source": {
          "default": "gh",
          "title": "Id Source",
          "type": "string"
        },
        "date_format": {
          "default": "iso",
          "title": "Date Format",
          "type": "string"
        },
        "author_id_format": {
          "default": "email",
          "title": "Author Id Format",
          "type": "string"
        },
        "allowed_author_ids": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "all",
          "title": "Allowed Author Ids"
        },
        "require": {
          "$ref": "#/$defs/ChangelogRequireConfig"
        }
      },
      "title": "ChangelogConfig",
      "type": "object"
    },
    "ChangelogRequireConfig": {
